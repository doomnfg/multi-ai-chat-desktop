<mxCell id="title" value='&lt;font color="#EF5B4B" face="Georgia" style="font-size:56px"&gt;AI Agent&lt;/font&gt;&lt;font style="font-size:48px"&gt; &lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;b&gt;的完整架構&lt;/b&gt;&lt;/font&gt;' style="fontFamily=Noto Sans TC;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans%2BTC;collapsible=0;text;html=1;fontColor=#222222;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="180" y="95" width="720" height="90" as="geometry"/></mxCell>
<mxCell id="goal" value='&lt;b style="font-size:14px"&gt;使用者目標（User Goal）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;例如：幫我做一份競爭對手分析並傳送到 Slack&lt;/font&gt;' style="fontFamily=Noto Sans TC;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans%2BTC;collapsible=0;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#E9F5E1;strokeColor=#8CC07A;" vertex="1" parent="1"><mxGeometry x="345" y="208" width="353" height="58" as="geometry"/></mxCell>
