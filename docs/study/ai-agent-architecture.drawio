<mxCell id="planner" value='&lt;b&gt;&lt;font color="#3A6FC4" style="font-size:15px"&gt;1. Planner（規劃）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;將目標拆解為可執行的任務步驟' style="fontFamily=Noto Sans TC;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans%2BTC;collapsible=0;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#E3EEFB;strokeColor=#7EA6E0;" vertex="1" parent="1"><mxGeometry x="345" y="300" width="353" height="65" as="geometry"/></mxCell>
<mxCell id="planner_i" value="🧠" style="fontFamily=Noto Sans TC;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans%2BTC;collapsible=0;text;html=1;fontColor=#222222;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="planner"><mxGeometry x="18" y="17" width="32" height="30" as="geometry"/></mxCell>
<mxCell id="steps" value="Step 1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;蒐集資料&lt;br&gt;Step 2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;整理資訊&lt;br&gt;Step 3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;分析比較&lt;br&gt;Step 4&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;製作 PPT&lt;br&gt;Step 5&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;傳送至 Slack" style="fontFamily=Noto Sans TC;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans%2BTC;collapsible=0;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#D6D6D6;" vertex="1" parent="1"><mxGeometry x="720" y="272" width="122" height="113" as="geometry"/></mxCell>
<mxCell id="reason" value='&lt;b&gt;&lt;font color="#D68A00" style="font-size:15px"&gt;2. Reasoning（推理）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;決定下一步要做什麼、如何做' style="fontFamily=Noto Sans TC;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans%2BTC;collapsible=0;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#FFF5D6;strokeColor=#E8C15A;" vertex="1" parent="1"><mxGeometry x="345" y="401" width="308" height="60" as="geometry"/></mxCell>
